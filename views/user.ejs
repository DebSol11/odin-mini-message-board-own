<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>

<body>
  <h1><%= title%></h1>
</body>
<ul>
  <% for (let i = 0; i < messages.length; i++) { %>
  <% if (messages[i].user === title) { %>
  <li>
    <%= messages[i].user %>
  </li>
  <li>
    <%= messages[i].text %>
  </li>
  <li>
    <%= messages[i].added %>
  </li>
  <br>
  <% } %>
  <% } %>

</html>